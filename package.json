{
  "name": "arango-server",
  "version": "0.5.2",
  "description": "A Model Context Protocol Server for ArangoDB",
  "type": "module",
  "bin": {
    "arango-server": "build/index.js"
  },
  "files": [
    "build/backupPaths.js",
    "build/handlers.js",
    "build/index.js",
    "build/tools.js",
    "build/types.js"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "npm run build && node --test build/*.test.js",
    "test:integration": "bash scripts/test-integration-docker.sh",
    "lint": "tsc --noEmit",
    "format": "npx prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "arango",
    "arangodb",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravenwits/mcp-server-arangodb.git"
  },
  "homepage": "https://github.com/ravenwits/mcp-server-arangodb#readme",
  "author": "Alp Sarıyer <hi@alpsariyer.dev>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "arangojs": "^10.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
